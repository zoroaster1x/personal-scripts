#!/usr/bin/env python3
import os
import sys
import argparse
import subprocess
import shutil
from rich.console import Console
from rich.panel import Panel

console = Console()

def print_help():
    help_text = """
[bold cyan]getAudio - Video to MP3 Extractor[/bold cyan]

[bold yellow]Usage:[/bold yellow]
  getAudio <INPUT_FILE> [options]

[bold yellow]Options:[/bold yellow]
  [green]-o, --output[/green]    Specify an exact output filename or directory.
                    (Default: Saves as './VideoName.mp3')
  [green]-q, --quality[/green]   MP3 Quality (VBR): [bold]0[/bold] (Best) to [bold]9[/bold] (Worst).
                    (Default: 2 - High Quality Music ~192kbps)
  [green]-l, --lecture[/green]   Lecture/Voice Mode: Forces Mono audio and 64kbps.
                    [dim](Use this to massively shrink podcasts and lectures!)[/dim]

[bold yellow]Examples:[/bold yellow]
  getAudio "./video.mp4"                        [dim]# High Quality Music Extraction[/dim]
  getAudio "./lecture.mp4" -l                   [dim]# Tiny File Size for Speech[/dim]
  getAudio "./video.mp4" -o "~/Music/song.mp3"  [dim]# Extracts to specific file[/dim]
    """
    console.print(Panel(help_text, border_style="cyan"))

def main():
    if len(sys.argv) == 1:
        print_help()
        return

    parser = argparse.ArgumentParser(add_help=False)
    parser.add_argument("input_file", help="Path to the local video/audio file")
    parser.add_argument("-o", "--output", help="Specific output file path or directory")
    parser.add_argument("-q", "--quality", type=int, choices=range(10), default=2, help="MP3 VBR Quality (0=Best, 9=Worst)")
    parser.add_argument("-l", "--lecture", action="store_true", help="Optimize for spoken word (Mono, 64kbps)")
    args = parser.parse_args()

    input_path = os.path.expanduser(args.input_file)

    if not os.path.exists(input_path):
        console.print(f"[red]✖ Error: File '{input_path}' not found.[/red]")
        return

    if not shutil.which("ffmpeg"):
        console.print("[red]✖ 'ffmpeg' is missing! Please install it (sudo pacman -S ffmpeg).[/red]")
        return

    dir_name, base_name = os.path.split(input_path)
    name, _ = os.path.splitext(base_name)

    # Determine Output Path
    if args.output:
        out_target = os.path.expanduser(args.output)
        if os.path.isdir(out_target) or out_target.endswith(('/', '\\')):
            os.makedirs(out_target, exist_ok=True)
            out_path = os.path.join(out_target, f"{name}.mp3")
        else:
            out_path = out_target
            os.makedirs(os.path.dirname(os.path.abspath(out_path)), exist_ok=True)
            if not out_path.lower().endswith('.mp3'):
                out_path += '.mp3'
    else:
        out_path = os.path.join(dir_name, f"{name}.mp3")

    console.print(f"\n[bold magenta]🎵 Extracting Audio:[/bold magenta] {base_name}")

    if args.lecture:
        console.print("[dim]Mode: Lecture/Voice (Mono, 64kbps CBR)...[/dim]")
        # -ac 1 downmixes to Mono
        # -b:a 64k forces a low constant bitrate perfect for human voices
        ffmpeg_cmd =[
            "ffmpeg", "-y",
            "-i", input_path,
            "-vn",
            "-c:a", "libmp3lame",
            "-ac", "1",
            "-b:a", "64k",
            out_path
        ]
    else:
        console.print(f"[dim]Encoding to MP3 (VBR Quality: {args.quality})...[/dim]")
        ffmpeg_cmd =[
            "ffmpeg", "-y",
            "-i", input_path,
            "-vn",
            "-c:a", "libmp3lame",
            "-q:a", str(args.quality),
            out_path
        ]

    try:
        # Run ffmpeg silently
        result = subprocess.run(ffmpeg_cmd, stdout=subprocess.DEVNULL, stderr=subprocess.PIPE, text=True)

        if result.returncode != 0:
            console.print(f"[red]✖ Extraction failed![/red]\n[dim]{result.stderr}[/dim]")
            if os.path.exists(out_path): os.remove(out_path)
            return

        out_mb = os.path.getsize(out_path) / (1024 * 1024)

        console.print(f"[green]✔ Audio Extracted Successfully![/green]")
        console.print(f"File Size: [cyan]{out_mb:.1f} MB[/cyan]")
        console.print(f"[dim]Saved to: {out_path}[/dim]\n")

    except KeyboardInterrupt:
        console.print("\n[red]Extraction Cancelled by User.[/red]")
        if os.path.exists(out_path): os.remove(out_path)
    except Exception as e:
        console.print(f"[red]✖ Error during extraction: {e}[/red]")
        if os.path.exists(out_path): os.remove(out_path)

if __name__ == "__main__":
    main()
