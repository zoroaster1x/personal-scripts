#!/usr/bin/env python3
import os
import sys
import argparse
import subprocess
import shutil
from rich.console import Console
from rich.panel import Panel

console = Console()

def print_help():
    help_text = """
[bold cyan]compressvid - RTX Accelerated Video Compressor[/bold cyan][bold yellow]Usage:[/bold yellow]
  compressvid <INPUT_FILE> [options]

[bold yellow]Options:[/bold yellow]
  [green]-c, --compress[/green]  Compression amount: [bold]light[/bold], [bold]medium[/bold] (default), [bold]high[/bold]
                    (High compression = smaller file size, lower quality)
  [green]-o, --output[/green]    Specify an exact output filename/path.
                    (Default: ./VideoName - (medium compression).mp4)
  [green]-r, --replace[/green]   Smart Replace: Compares the new file size to the original.
                    If the new file is smaller, it replaces the original.
                    If it's larger or saves < 1MB, it discards the new file.
  [green]-a, --audio[/green]     Also extract the audio into an MP3 (calls getAudio automatically).

[bold yellow]Examples:[/bold yellow]
  compressvid "./video.mp4"                        [dim]# Creates "./video - (medium compression).mp4"[/dim]
  compressvid "./video.mp4" -c high                [dim]# Max compression[/dim]
  compressvid "./video.mp4" -r -a                  [dim]# Smart replace & extract MP3![/dim]
    """
    console.print(Panel(help_text, border_style="cyan"))

def main():
    if len(sys.argv) == 1:
        print_help()
        return

    parser = argparse.ArgumentParser(add_help=False)
    parser.add_argument("input_file", help="Path to the local video file")
    parser.add_argument("-c", "--compress", choices=['light', 'medium', 'high'], default='medium', help="Compression level")
    parser.add_argument("-o", "--output", help="Specific output file path")
    parser.add_argument("-r", "--replace", action="store_true", help="Smart replace original file")
    parser.add_argument("-a", "--audio", action="store_true", help="Extract MP3 audio using getAudio")
    args = parser.parse_args()

    input_path = os.path.expanduser(args.input_file)

    if not os.path.exists(input_path):
        console.print(f"[red]✖ Error: File '{input_path}' not found.[/red]")
        return

    if not shutil.which("ffmpeg"):
        console.print("[red]✖ 'ffmpeg' is missing! Please install it (sudo pacman -S ffmpeg).[/red]")
        return

    cq_map = {'light': 24, 'medium': 29, 'high': 34}
    cq_val = cq_map[args.compress]

    dir_name, base_name = os.path.split(input_path)
    name, ext = os.path.splitext(base_name)

    if args.output:
        comp_path = os.path.expanduser(args.output)
    else:
        comp_path = os.path.join(dir_name, f"{name} - ({args.compress} compression){ext}")

    if os.path.abspath(input_path) == os.path.abspath(comp_path):
        console.print("[red]✖ Error: Output path cannot be exactly the same as the Input path unless using `-r`![/red]")
        return

    console.print(f"\n[bold magenta]🗜 Compressing ({args.compress}):[/bold magenta] {base_name}")
    console.print(f"[dim]Using RTX GPU (CUDA Decode + NVENC Encode) at CQ {cq_val}...[/dim]")

    ffmpeg_cmd =[
        "ffmpeg", "-y",
        "-hwaccel", "cuda",
        "-i", input_path,
        "-c:v", "hevc_nvenc", "-preset", "p5", "-cq", str(cq_val),
        "-c:a", "copy", comp_path
    ]

    try:
        result = subprocess.run(ffmpeg_cmd, stdout=subprocess.DEVNULL, stderr=subprocess.PIPE, text=True)

        if result.returncode != 0:
            console.print(f"[red]✖ Compression failed![/red]\n[dim]{result.stderr}[/dim]")
            if os.path.exists(comp_path): os.remove(comp_path)
            return

        orig_size = os.path.getsize(input_path)
        comp_size = os.path.getsize(comp_path)
        diff = orig_size - comp_size

        orig_mb = orig_size / (1024 * 1024)
        comp_mb = comp_size / (1024 * 1024)
        diff_mb = diff / (1024 * 1024)

        # TRIGGER AUDIO EXTRACTION BEFORE WE DELETE ANYTHING
        if args.audio:
            if shutil.which("getAudio"):
                # Call your getAudio script natively!
                subprocess.run(["getAudio", input_path])
            else:
                console.print("[red]✖ 'getAudio' script not found! Make sure it is executable.[/red]")

        # Smart Replace Logic
        if args.replace:
            if diff <= (1024 * 1024) or comp_size >= orig_size:
                console.print(f"[yellow]⚠ Compression ineffective.[/yellow] (Orig: {orig_mb:.1f}MB ➔ New: {comp_mb:.1f}MB)")
                console.print("[dim]Discarding compressed version and keeping original.[/dim]")
                os.remove(comp_path)
            else:
                console.print(f"[green]✔ Smart Replace successful![/green] (Orig: {orig_mb:.1f}MB ➔ New: {comp_mb:.1f}MB)")
                console.print(f"[bold cyan]Saved {diff_mb:.1f} MB![/bold cyan]")
                os.remove(input_path)
                os.rename(comp_path, input_path)
        else:
            console.print(f"[green]✔ Compression complete![/green]")
            console.print(f"Original: [yellow]{orig_mb:.1f} MB[/yellow] ➔ Compressed: [green]{comp_mb:.1f} MB[/green]")
            if comp_size < orig_size:
                console.print(f"[bold cyan]Saved {diff_mb:.1f} MB![/bold cyan]")
            else:
                console.print("[bold red]Warning: The compressed file is actually larger than the original.[/bold red]")
            console.print(f"[dim]Saved to: {comp_path}[/dim]\n")

    except KeyboardInterrupt:
        console.print("\n[red]Compression Cancelled by User.[/red]")
        if os.path.exists(comp_path): os.remove(comp_path)
    except Exception as e:
        console.print(f"[red]✖ Error during compression: {e}[/red]")
        if os.path.exists(comp_path): os.remove(comp_path)

if __name__ == "__main__":
    main()
